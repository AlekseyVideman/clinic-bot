{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "patientPhoneNumber": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "pattern": "^(0[1-9]|[12]\\d|3[01])\\.(0[1-9]|1[0-2])$"
    },
    "startEndTime": {
      "type": "string",
      "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d\\s*-?\\s*(?:[01]\\d|2[0-3]):[0-5]\\d$"
    },
    "goal": {
      "type": "string"
    }
  },
  "required": ["patientPhoneNumber", "date", "startEndTime"]
}
